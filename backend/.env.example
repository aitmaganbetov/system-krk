MYSQL_ROOT_PASSWORD=change-this-db-root-password
MYSQL_DATABASE=krk_monitoring
MYSQL_ROOT_HOST=%

DB_HOST=db
DB_PORT=3306
DB_NAME=krk_monitoring
DB_USER=root
DB_PASSWORD=change-this-db-root-password

READONLY_DB_HOST=host.docker.internal
READONLY_DB_PORT=6080
READONLY_DB_NAME=nitro
READONLY_DB_USER=change-this-readonly-user
READONLY_DB_PASSWORD=change-this-readonly-password

LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3307
LOCAL_DB_NAME=krk_monitoring
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=change-this-local-db-password

CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_METHODS=GET,POST,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type

SECRET_KEY=change-this-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password